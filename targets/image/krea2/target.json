{
  "id": "krea2",
  "kind": "image",
  "label": "Krea 2 turbo (reference images)",
  "short": "krea2",
  "code": "prompt.py",

  "template": {
    "_note": "Sizes a reference is generated at. A character sheet is four square views stitched by mksheet, never one 4096x1024 canvas.",
    "view_size": [1024, 1024],
    "plate_size": [1344, 768],
    "object_size": [1024, 1024]
  },

  "recipe": {
    "_note": "The views of a character sheet, in sheet order, left to right. prompt.py holds each view's wording.",
    "views": ["01_threequarter", "02_side", "03_back", "04_face"]
  },

  "binding": {
    "workflow": "workflow.json",
    "workflow_name": "krea2_refs_t2i.json",
    "env": "KREA_WORKFLOW",
    "saver": {"class_type": "H3SaveRefTake", "replaces": "SaveImage"},
    "params": {
      "model": {"class_type": "UNETLoader", "field": "unet_name"},
      "loras": {"class_type": "LoraLoader", "name": "lora_name",
                "strength": "strength_model", "strength_clip": "strength_clip",
                "chain": true},
      "steps": {"class_type": "KSampler", "field": "steps"},
      "seed": {"class_type": "KSampler", "field": "seed"},
      "cfg": {"class_type": "KSampler", "field": "cfg"}
    },
    "graph": {
      "_note": "The built-in graph (graph.py) when no workflow file is found.",
      "clip": "qwen3vl_4b_fp8_scaled.safetensors",
      "clip_type": "krea2",
      "vae": "wan_2.1_vae.safetensors",
      "sampler": "euler",
      "scheduler": "beta",
      "prefix": "h3refs/tmp"
    }
  },

  "presets": {
    "_note": "No style LoRA by default: references have to match whatever look series.json asks for, and a realism LoRA fights a storybook one (and vice versa).",
    "final": {
      "model": "krea2_turbo_fp8_scaled.safetensors",
      "lora": "", "lora_strength": 1.0, "lora_clip_strength": 1.0,
      "steps": 12, "cfg": 1.0
    }
  }
}
